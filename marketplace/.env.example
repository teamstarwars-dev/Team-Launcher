# Copier en « .env » sur le serveur. Ce fichier-ci est un MODÈLE : aucune
# vraie valeur ici, le dépôt est public.

# Onglet « Databases » du panneau : l'adresse SANS mot de passe, puis le
# mot de passe sur sa propre ligne, copié tel quel (aucun encodage).
TL_MARKET_DB_URL=mysql+pymysql://UTILISATEUR@HOTE:3306/BASE?charset=utf8mb4
TL_MARKET_DB_PASSWORD=

# Dossiers et fichiers, relatifs au dossier du serveur.
TL_MARKET_STORAGE=storage
TL_MARKET_SIGNING_KEY=keys/market-2026a.key
TL_MARKET_SIGNING_CERT=keys/market-2026a.cert.json

# 64 caractères hexadécimaux, générés UNE fois (ne jamais les changer
# ensuite : les 2FA déjà posées deviendraient illisibles).
TL_MARKET_TOTP_KEY=

# HTTPS direct (certificat d'origine Cloudflare). Laisser vide pour HTTP.
TL_MARKET_TLS_CERT=keys/origin.pem
TL_MARKET_TLS_KEY=keys/origin.key
