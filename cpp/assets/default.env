// ═══════════════════════════════════════════════════════════════════════
// Team Launcher — Configuration par défaut (embarquée dans le launcher)
// Ce fichier est lu au démarrage. Les valeurs ici s'appliquent à TOUS
// les utilisateurs qui n'ont pas encore modifié ces paramètres.
// ═══════════════════════════════════════════════════════════════════════

// Discord Rich Presence (affiche l'instance en cours sur ton profil Discord)
DISCORD_APP_ID=1541468112740941844
DISCORD_ENABLED=true

// Télémétrie — rapports de crash et stats envoyés vers Discord
TELEMETRY_ENABLED=true
// DISCORD_TELEMETRY_WEBHOOK : injecte a la compilation depuis
// build-secrets.env (non suivi). Jamais en clair dans le depot.
// Renseigner la ligne ci-dessous reste possible pour pointer sur un
// webhook maison sans recompiler.
// DISCORD_TELEMETRY_WEBHOOK=

// Mise à jour auto — vide = API GitHub Releases, qui sait choisir
// l'archive de LA bonne plateforme (le .exe pour Windows, le .deb pour
// Linux). Un version.json unique ne le sait pas : il ne porte qu'une
// seule URL. Renseigner cette ligne reste possible pour pointer sur un
// flux maison (voir docs : {version, urlWindows, urlLinux, changelog}).
// UPDATE_URL=

// Langue par défaut (fr ou en)
LANGUAGE=fr

// CurseForge API (optionnel — pour importer des modpacks)
// CURSEFORGE_API_KEY=

// Activer le compteur FPS en jeu
FPS_COUNTER_ENABLED=false
